#!/usr/bin/env sh
# tmux-ai-resurrect — persist AI coding-harness session IDs per tmux pane.
#
# See https://github.com/webertim/tmux-ai-resurrect for docs.

set -eu

VERSION="0.1.0"

CACHE_DIR="${TMUX_AI_RESURRECT_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/tmux-ai-resurrect}"

# Resolve $0 through any chain of symlinks so we can locate integrations/
# even when the CLI is symlinked into ~/.local/bin/.
_resolve_self() {
	self="$1"
	while [ -L "$self" ]; do
		dir=$(cd "$(dirname "$self")" && pwd)
		target=$(readlink "$self")
		case "$target" in
			/*) self="$target" ;;
			*)  self="$dir/$target" ;;
		esac
	done
	cd "$(dirname "$self")" && pwd
}
BIN_DIR=$(_resolve_self "$0")
ROOT_DIR=$(cd "$BIN_DIR/.." && pwd)
INTEGRATIONS_DIR="$ROOT_DIR/integrations"

die() {
	printf 'tmux-ai-resurrect: %s\n' "$*" >&2
	exit 1
}

# Stable pane key: <session>--<window_idx>--<pane_idx>.
# We deliberately avoid the volatile tmux pane id (%N), which is reassigned
# across server restarts and would break resurrect-driven restore.
pane_key() {
	command -v tmux >/dev/null 2>&1 || die "tmux not found on PATH"
	[ -n "${TMUX_PANE:-}" ] || die "no tmux pane in context (\$TMUX_PANE unset)"
	tmux display-message -p -t "$TMUX_PANE" \
		'#{session_name}--#{window_index}--#{pane_index}'
}

cache_file_for() {
	# cache_file_for <pane_key> <harness>
	key="$1"; harness="$2"
	safe=$(printf '%s' "$key" | tr '/' '_')
	printf '%s/%s-%s.session\n' "$CACHE_DIR" "$safe" "$harness"
}

# set --harness NAME --session-id ID
cmd_set() {
	harness=""
	session_id=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--harness)    harness="$2"; shift 2 ;;
			--session-id) session_id="$2"; shift 2 ;;
			-h|--help)
				cat <<'EOF'
Usage: tmux-ai-resurrect set --harness NAME --session-id ID

Records the current AI session id for this tmux pane. Integrations are
responsible for extracting the id from whatever their harness emits.
EOF
				return 0
				;;
			*) die "set: unknown arg: $1" ;;
		esac
	done
	[ -n "$harness" ] || die "set: --harness required"
	[ -n "$session_id" ] || die "set: --session-id required"

	mkdir -p "$CACHE_DIR"
	file=$(cache_file_for "$(pane_key)" "$harness")
	printf '%s\n' "$session_id" >"$file.tmp"
	mv -f "$file.tmp" "$file"
}

# resume <harness>
#
# Exec the given harness, resuming its saved session for the current pane if
# one is on record. Called by tmux-resurrect via @resurrect-processes.
cmd_resume() {
	harness="${1:-}"
	[ -n "$harness" ] || die "resume: harness name required"
	command -v "$harness" >/dev/null 2>&1 || die "resume: $harness not on PATH"

	file=$(cache_file_for "$(pane_key)" "$harness")
	session_id=""
	[ -f "$file" ] && session_id=$(cat "$file")

	if [ -z "$session_id" ]; then
		exec "$harness"
	fi
	case "$harness" in
		opencode) exec "$harness" --session "$session_id" ;;
		claude)   exec "$harness" --resume  "$session_id" ;;
		*)        exec "$harness" ;;
	esac
}

list_harnesses() {
	[ -d "$INTEGRATIONS_DIR" ] || return 0
	for dir in "$INTEGRATIONS_DIR"/*/; do
		[ -f "$dir/install.sh" ] || continue
		basename "$dir"
	done
}

_run_harness_script() {
	# _run_harness_script <phase> <harness> [args...]
	phase="$1"; harness="$2"; shift 2
	script="$INTEGRATIONS_DIR/$harness/$phase.sh"
	[ -f "$script" ] || die "$phase: no integration for '$harness' (looked for $script)"
	TMUX_AI_RESURRECT_CLI="$BIN_DIR/tmux-ai-resurrect" \
	TMUX_AI_RESURRECT_ROOT="$ROOT_DIR" \
		sh "$script" "$@"
}

# install <harness> [flags] | install --all
cmd_install() {
	[ $# -gt 0 ] || die "install: harness name or --all required"
	if [ "$1" = "--all" ]; then
		shift
		for h in $(list_harnesses); do
			printf '== install %s ==\n' "$h"
			_run_harness_script install "$h" "$@" || printf 'install %s: failed\n' "$h" >&2
		done
		return 0
	fi
	h="$1"; shift
	_run_harness_script install "$h" "$@"
}

cmd_uninstall() {
	[ $# -gt 0 ] || die "uninstall: harness name or --all required"
	if [ "$1" = "--all" ]; then
		shift
		for h in $(list_harnesses); do
			printf '== uninstall %s ==\n' "$h"
			_run_harness_script uninstall "$h" "$@" || printf 'uninstall %s: failed\n' "$h" >&2
		done
		return 0
	fi
	h="$1"; shift
	_run_harness_script uninstall "$h" "$@"
}

cmd_doctor() {
	if [ $# -gt 0 ]; then
		_run_harness_script status "$1"
		return $?
	fi
	printf 'tmux-ai-resurrect %s\n' "$VERSION"
	printf 'cache dir: %s\n' "$CACHE_DIR"
	printf '\nHarness status:\n'
	for h in $(list_harnesses); do
		printf '  %s: ' "$h"
		_run_harness_script status "$h" || true
	done
}

usage() {
	cat <<'EOF'
Usage: tmux-ai-resurrect <command> [args]

Commands:
  set        Record the current AI session ID for this pane.
  resume     Exec an AI harness, resuming this pane's saved session.
  install    Install the integration for a harness (or --all).
  uninstall  Remove the integration for a harness (or --all).
  doctor     Report per-harness install status.

Run `tmux-ai-resurrect <command> --help` for command-specific options.
EOF
}

[ $# -gt 0 ] || { usage; exit 2; }
sub="$1"; shift
case "$sub" in
	set)                    cmd_set "$@" ;;
	resume)                 cmd_resume "$@" ;;
	install)                cmd_install "$@" ;;
	uninstall)              cmd_uninstall "$@" ;;
	doctor)                 cmd_doctor "$@" ;;
	version|-V|--version)   printf 'tmux-ai-resurrect %s\n' "$VERSION" ;;
	help|-h|--help)         usage ;;
	*) die "unknown command: $sub (try 'tmux-ai-resurrect help')" ;;
esac
